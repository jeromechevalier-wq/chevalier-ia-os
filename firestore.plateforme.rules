rules_version = '2';
// Plateforme clients (projet Firebase « chevalier-ia-app »). Ne concerne PAS le CRM de Jérôme (firestore.rules).
// Tout est refusé par défaut, sauf la fiche de marque (marques/<client>, lecture publique d'un document précis, voir plus bas). Un compte (e-mail vérifié) n'a de droits que chez les clients dont il est membre :
//   clients/<client>/membres/<e-mail en minuscules>  avec un champ « role » : « editeur » (lit et écrit) ou « lecteur » (lit seulement).
// Un compte peut être membre de plusieurs clients (une fiche par client), et n'a de droits que dans ceux-là.
// Les fiches d'appartenance ne s'écrivent jamais depuis un navigateur (ni créer, ni modifier, ni supprimer) : elles sont gérées par le
// serveur (outil « nouveau client », chantier 13), qui contourne les règles. Un membre ne peut donc ni s'ajouter, ni changer son rôle.
// Le serveur MCP et les fonctions contournent aussi les règles : leur isolation par client est écrite dans leur code (chantiers 9 et 10).
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email != null;
    }

    function roleDe(client) {
      return connecte()
        && exists(/databases/$(database)/documents/clients/$(client)/membres/$(request.auth.token.email.lower()))
        ? get(/databases/$(database)/documents/clients/$(client)/membres/$(request.auth.token.email.lower())).data.get('role', '')
        : '';
    }

    // Fiche de marque d'un client (chantier 5) : lisible SANS connexion, pour afficher la page de connexion à ses couleurs.
    // On ne peut lire qu'UN document précis (get), jamais la liste des clients (list) ; aucune écriture depuis un navigateur
    // (la fiche est créée par Jérôme ou par l'outil « nouveau client »). Une fiche absente OU inactive est refusée de la même façon :
    // on ne peut pas deviner quels clients existent. Elle ne contient que du visuel (nom, couleurs, logo, images, texte d'accueil).
    match /marques/{client} {
      allow get: if resource.data.get('actif', false) == true;
      allow list, write: if false;
    }

    // Sa propre fiche (pour savoir à quels clients on appartient), toujours lisible. Depuis le module « Accès MCP » (16/10/2026), un membre (éditeur ou lecteur)
    // peut aussi LIRE les fiches des autres membres de SON client (adresse, nom, rôle), pour la page « Qui peut se connecter » : jamais celles d'un autre client.
    // Aucune écriture depuis un navigateur, quoi qu'il arrive (on ne s'ajoute pas, on ne change pas un rôle).
    match /clients/{client}/membres/{email} {
      allow get: if connecte() && (email == request.auth.token.email.lower() || roleDe(client) in ['editeur', 'lecteur']);
      allow list: if roleDe(client) in ['editeur', 'lecteur'];
      allow write: if false;
    }

    // Fiche du client (chantier 7) : le document « clients/<client> » lui-même, qui porte le champ « modules » (modules actifs).
    // Un membre (éditeur ou lecteur) le LIT, lui seul ; personne ne l'écrit depuis un navigateur (Jérôme ou l'outil « nouveau client »,
    // chantier 13, qui contourne les règles). Pas de liste des clients. Ne rien mettre de confidentiel dans ce document : tous les
    // membres du client le lisent. Un client sans document (ou sans champ « modules ») n'a simplement aucun module actif.
    match /clients/{client} {
      allow get: if roleDe(client) in ['editeur', 'lecteur'];
      allow list, write: if false;
    }

    // Collections du journal d'activité des workflows (chantier 14) : workflows, executions (et leurs « steps »), sync.
    // Lisibles par les membres, mais écrites par le SERVEUR seulement (la copie horaire, la fonction « renommer », la porte et la fonction de validation des propositions), jamais par un navigateur,
    // même par un éditeur : sinon un navigateur pourrait fausser l'historique ou le verrou de copie.
    function collectionDuJournal(collection) {
      return collection in ['workflows', 'executions', 'sync', 'automatisations_propositions'];
    }

    // Tableau de bord : lisible par les membres, écrit par le SERVEUR seulement (la porte des scripts GitHub et les fonctions de saisie), jamais par un navigateur,
    // même par un éditeur : sinon un éditeur pourrait se fabriquer un « vert ».
    function collectionDuTableauDeBord(collection) {
      return collection in ['tableaudebord_indicateurs', 'tableaudebord_releves', 'tableaudebord_demandes'];
    }

    // Bordereau du module Devis (24/10/2026) : les membres lisent ; les éditeurs créent et modifient les articles, mais ne les SUPPRIMENT jamais
    // (un article se désactive : les devis déjà faits en gardent une copie). Un autre client n'y a aucun accès (chemin sous clients/<client>).
    function collectionSansSuppression(collection) {
      return collection in ['devis_articles'];
    }
    match /clients/{client}/devis_articles/{id} {
      allow read: if roleDe(client) in ['editeur', 'lecteur'];
      allow create, update: if roleDe(client) == 'editeur';
      allow delete: if false;
    }

    // Devis (module Devis, 24/10/2026). Les membres LISENT les devis ; un éditeur peut créer un BROUILLON neuf (sans numéro, version 1), puis le modifier TANT QU'IL RESTE un
    // brouillon (avant ET après), sans toucher à son numéro, sa racine, sa version, son statut ni sa date de finalisation. Finaliser, marquer envoyé, signer, refuser, créer la
    // version suivante et archiver passent par les fonctions du serveur (devisFinaliser…), qui contournent les règles. Aucune suppression depuis un navigateur.
    // Le compteur des numéros (devis_compteurs) est réservé au serveur : ni lecture ni écriture, même par un éditeur.
    function devisBrouillonNeuf(id) {
      let d = request.resource.data;
      return d.get('statut', '') == 'brouillon' && d.get('numero', null) == null && !('finaliseLe' in d)
        && d.get('racineId', '') == id && d.get('version', 0) == 1;
    }
    function devisBrouillonModifie() {
      return resource.data.get('statut', '') == 'brouillon' && request.resource.data.get('statut', '') == 'brouillon'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['numero', 'racineId', 'version', 'statut', 'finaliseLe']);
    }
    // crm_actions_lancements : le journal des demandes « Préparer l'e-mail » d'un devis (25/10/2026), fermé aux navigateurs plus bas.
    function collectionDesDevis(collection) {
      return collection in ['devis_devis', 'devis_compteurs', 'crm_actions_lancements'];
    }
    match /clients/{client}/devis_devis/{id} {
      allow read: if roleDe(client) in ['editeur', 'lecteur'];
      allow create: if roleDe(client) == 'editeur' && devisBrouillonNeuf(id);
      allow update: if roleDe(client) == 'editeur' && devisBrouillonModifie();
      allow delete: if false;
    }
    match /clients/{client}/devis_compteurs/{id} {
      allow read, write: if false;
    }
    // Journal des demandes « Préparer l'e-mail » d'un devis (anti-doublon, identifiants, statuts) : écrit par le SERVEUR seulement
    // (fonction devisPreparerEmail, porte devis.noterEmailPrepare), aucun écran ne le lit. Ni lecture ni écriture depuis un navigateur, même par un éditeur (25/10/2026).
    match /clients/{client}/crm_actions_lancements/{id} {
      allow read, write: if false;
    }

    // Fiches des fichiers déposés dans l'onglet « Documents » (28/10/2026) : les membres LISENT ; l'écriture est réservée au SERVEUR (fonctions documentDeposer, documentSupprimer,
    // outils MCP), même pour un éditeur : sinon il pourrait y inscrire un chemin quelconque du stockage, que documentLien signerait ensuite.
    function collectionDesDocuments(collection) {
      return collection in ['documents_stockes'];
    }
    match /clients/{client}/documents_stockes/{id} {
      allow read: if roleDe(client) in ['editeur', 'lecteur'];
      allow write: if false;
    }

    // Les données du client (tout sauf les fiches d'appartenance, traitées ci-dessus).
    match /clients/{client}/{collection}/{reste=**} {
      allow read: if collection != 'membres' && collection != 'devis_compteurs' && collection != 'crm_actions_lancements' && roleDe(client) in ['editeur', 'lecteur'];
      allow write: if collection != 'membres' && !collectionDesDocuments(collection) && !collectionDuJournal(collection) && !collectionDuTableauDeBord(collection) && !collectionSansSuppression(collection) && !collectionDesDevis(collection) && roleDe(client) == 'editeur';
    }

    // Tout le reste (racine, autres collections) : refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
