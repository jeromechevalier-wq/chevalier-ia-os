# Installations et fichiers générés (jamais commités)
node_modules/
tests/node_modules/
tests/test-results/
tests/playwright-report/
tests/.cache/
*.log
firebase-debug*.log
firestore-debug*.log
ui-debug*.log
.firebase/
.DS_Store

# Copie générée avant chaque déploiement et chaque test (scripts/preparer-fonctions.js)
functions/partage/

# Paquets de déploiement générés (scripts/preparer-hebergement.js)
dist/

# Copie du serveur MCP pour la plateforme clients (scripts/preparer-fonctions.js)
functions-plateforme/serveur/

# Copies de configuration générées pour les tests (ports décalés)
tests/.config-ports/

# Fichiers de paramètres locaux des fonctions (aucune étape du workflow de déploiement n'en écrit plus)
functions/.env*
